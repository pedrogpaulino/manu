# Exemplo seguro para execução local do Manu.
#
# Copie para .env (arquivo ignorado pelo Git) e altere somente o que for
# necessário para o seu ambiente. Não coloque chaves, senhas ou tokens neste
# arquivo nem no repositório. Veja docs/configuration.md para a referência
# completa das variáveis MANU_*.

# O modo inicial não tem autenticação e deve permanecer em loopback.
MANU_SERVER_MODE=platform
MANU_SERVER_LISTEN_ADDRESS=127.0.0.1:8080
MANU_ORGANIZATION_ID=local
MANU_ORGANIZATION_NAME="Local organization"
MANU_INGESTION_STAGING_DIRECTORY=/tmp/manu/ingestions

# Conexão lógica com PostgreSQL. O Compose pode substituir o host conforme a
# rede local. Forneça a senha somente no .env ignorado ou por secret mount.
MANU_POSTGRES_HOST=127.0.0.1
MANU_POSTGRES_PORT=5432
MANU_POSTGRES_DATABASE=manu
MANU_POSTGRES_USER=manu
MANU_POSTGRES_PASSWORD=
MANU_POSTGRES_SSL_MODE=disable
MANU_POSTGRES_MAX_OPEN_CONNS=10
MANU_POSTGRES_MAX_IDLE_CONNS=5
MANU_POSTGRES_CONN_MAX_LIFETIME=30m
MANU_POSTGRES_CONN_MAX_IDLE_TIME=5m

# Limite inicial e política conservadora: persistência local permitida,
# transferência para provedores externos bloqueada.
MANU_POLICY_PERSIST=allow
MANU_POLICY_EXTERNAL_TRANSFER=deny

# Embedding e geração são capacidades independentes e ficam desabilitadas
# neste exemplo. Habilite cada uma somente com um perfil, política e orçamento
# próprios. Os valores abaixo são encaminhados ao serviço api pelo Compose.
MANU_EMBEDDING_ENABLED=false
MANU_EMBEDDING_PROVIDER=
MANU_EMBEDDING_MODEL=
MANU_EMBEDDING_BASE_URL=
MANU_EMBEDDING_TIMEOUT=30s
MANU_EMBEDDING_MAX_BATCH_SIZE=32
MANU_EMBEDDING_DIMENSION=0
MANU_EMBEDDING_BUDGET_MAX_REQUESTS=0
MANU_EMBEDDING_BUDGET_MAX_INPUT_TOKENS=0
MANU_EMBEDDING_BUDGET_MAX_OUTPUT_TOKENS=0
MANU_EMBEDDING_BUDGET_MAX_COST_USD=0
MANU_GENERATION_ENABLED=false
MANU_GENERATION_PROVIDER=
MANU_GENERATION_MODEL=
MANU_GENERATION_BASE_URL=
MANU_GENERATION_PROTOCOL=responses
MANU_GENERATION_TIMEOUT=1m
MANU_GENERATION_MAX_OUTPUT_TOKENS=2048
MANU_GENERATION_TEMPERATURE=0
MANU_GENERATION_BUDGET_MAX_REQUESTS=0
MANU_GENERATION_BUDGET_MAX_INPUT_TOKENS=0
MANU_GENERATION_BUDGET_MAX_OUTPUT_TOKENS=0
MANU_GENERATION_BUDGET_MAX_COST_USD=0

# O modo simulado não faz rede e é o padrão para testes/eval locais.
MANU_EVALUATION_LIVE=false

# Quando uma chamada externa for explicitamente autorizada, use a chave
# correspondente somente no ambiente/secret mount do processo. Nunca
# substitua os valores vazios abaixo por uma chave no repositório:
MANU_EMBEDDING_API_KEY=
MANU_GENERATION_API_KEY=
